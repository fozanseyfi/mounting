# Prisma — PostgreSQL bağlantısı (Vercel Postgres yapınca otomatik gelir)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require"

# Lokalde Postgres çalıştırıyorsanız:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/solar_bom"

# İletişim formu için Gmail SMTP (opsiyonel — /contact sayfası kullanır)
# GMAIL_USER="bilgi@example.com"
# GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
